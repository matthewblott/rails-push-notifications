<p style="color: green"><%= notice %></p>

<style>
  p {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    font-size: 1.2rem;
    text-align: center;
  }
</style>

<% content_for :title, 'Todos' %>

<% content_for :header_controls do %>
  <div role="group">
    <a href="<%= user_home_path %>" role="button">Home</a>
    <a href="<%= user_new_todo_path %>" role="button" data-controller="bridge--button">New</a>
  </div>
<% end %>

<section id="todos_element">
  <% @todos.each do |todo| %>
    <%= render partial: 'todos/todo', locals: { todo: todo } %>
  <% end %>

  <% if @pagy.next %>
    <%= turbo_frame_tag "pagination_#{@pagy.next}", 
        src: user_todos_path(page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
