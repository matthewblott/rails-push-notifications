<% if todo.errors.any? %>
  <div style="color: red">
    <h2><%= pluralize(todo.errors.count, 'error') %> prohibited this todo from being saved:</h2>
    <ul>
      <% todo.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form method="post" id="todo_form">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <fieldset>
    <label>
      <span>Title</span>
      <input
        name="todo[title]"
        placeholder="Buy groceries"
        value="<%= todo.title %>"
      >
    </label>
    <label>
      <span>Details</span>
      <textarea name="todo[details]" class="autosize" class="pill" placeholder="Milk, eggs, bread"><%= todo.details %></textarea>
    </label>
    <label>
      <span>Completed</span>
      <input type="hidden" name="todo[completed]" value="0">
      <input type="checkbox" name="todo[completed]" value="1" <%= todo.completed ? "checked" : "" %>>
    </label>
  </fieldset>
</form>
